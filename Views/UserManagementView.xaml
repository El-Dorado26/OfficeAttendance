<UserControl
    x:Class="OfficeAttendance.Views.UserManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="30,25,30,20">

            <TextBlock
                Text="User Management"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage office employees and their accounts."
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30,0,30,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Users List -->
            <Border
                Grid.Column="0"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock
                        Text="Employees"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,15"/>

                    <DataGrid
                        x:Name="UsersDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Username"
                                Binding="{Binding Username}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Full Name"
                                Binding="{Binding FullName}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Role"
                                Binding="{Binding Role}"
                                Width="*"/>

                            <DataGridCheckBoxColumn
                                Header="Active"
                                Binding="{Binding IsActive}"
                                Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- Add User -->
            <Border
                Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Add Employee"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"/>

                    <TextBlock Text="Username"/>

                    <ui:TextBox
                        x:Name="UsernameTextBox"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Full Name"/>

                    <ui:TextBox
                        x:Name="FullNameTextBox"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Password"/>

                    <ui:PasswordBox
                        x:Name="PasswordBox"
                        Margin="0,5,0,15"/>

                    <TextBlock Text="Role"/>

                    <ui:TextBox
                        x:Name="RoleTextBox"
                        Text="Employee"
                        Margin="0,5,0,20"/>

                    <ui:Button
                        Content="Add Employee"
                        Click="AddEmployeeButton_Click"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock
                        x:Name="MessageText"
                        Margin="0,15,0,0"
                        TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>

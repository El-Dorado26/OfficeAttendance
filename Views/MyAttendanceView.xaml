 <UserControl
    x:Class="OfficeAttendance.Views.MyAttendanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="#F6F2FC">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Purple Header -->
        <Border
            Grid.Row="0"
            Background="#6C3CCB"
            CornerRadius="0,0,20,20"
            Padding="30,24"
            Margin="0,0,0,24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="MY ATTENDANCE"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#E4D7FF"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="Attendance History"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="White"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Review your check-in times, check-out times, and working hours."
                        FontSize="14"
                        Foreground="#F0E9FF"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"/>

                </StackPanel>

                <Border
                    Grid.Column="1"
                    Width="58"
                    Height="58"
                    Background="#8059D7"
                    CornerRadius="29"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0">

                    <TextBlock
                        Text="&#x1F4C5;"
                        FontSize="27"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30,0,30,30">

                <!-- Attendance History Card -->
                <Border
                    Background="White"
                    CornerRadius="18"
                    Padding="24"
                    BorderBrush="#E8E0F5"
                    BorderThickness="1">

                    <StackPanel>

                        <!-- Section Heading -->
                        <TextBlock
                            Text="Your Records"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#30234A"/>

                        <TextBlock
                            Text="Select a date range to find specific attendance records."
                            FontSize="13"
                            Foreground="#827A91"
                            TextWrapping="Wrap"
                            Margin="0,6,0,22"/>

                        <!-- Date Filters -->
                        <Border
                            Background="#F8F5FD"
                            BorderBrush="#E7DDF7"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,20">

                            <StackPanel>

                                <TextBlock
                                    Text="FILTER ATTENDANCE"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#7952C7"
                                    Margin="0,0,0,14"/>

                                <WrapPanel
                                    VerticalAlignment="Center">

                                    <StackPanel
                                        Margin="0,0,18,12">

                                        <TextBlock
                                            Text="From date"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#514567"
                                            Margin="0,0,0,7"/>

                                        <DatePicker
                                            x:Name="FromDatePicker"
                                            Width="155"
                                            Height="34"/>

                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,0,18,12">

                                        <TextBlock
                                            Text="To date"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#514567"
                                            Margin="0,0,0,7"/>

                                        <DatePicker
                                            x:Name="ToDatePicker"
                                            Width="155"
                                            Height="34"/>

                                    </StackPanel>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,12">

                                        <ui:Button
                                            Content="Search"
                                            Click="SearchButton_Click"
                                            MinWidth="100"
                                            Height="36"
                                            Padding="16,5"
                                            Margin="0,0,10,0"
                                            Background="#6C3CCB"
                                            Foreground="White"/>

                                        <ui:Button
                                            Content="Clear"
                                            Click="ClearButton_Click"
                                            MinWidth="85"
                                            Height="36"
                                            Padding="16,5"
                                            Background="#EDE5FA"
                                            Foreground="#57319B"/>

                                    </StackPanel>

                                </WrapPanel>

                            </StackPanel>

                        </Border>

                        <!-- Table Heading -->
                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="Attendance Details"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#30234A"
                                VerticalAlignment="Center"/>

                            <Border
                                Grid.Column="1"
                                Background="#F0E8FC"
                                CornerRadius="10"
                                Padding="10,5">

                                <TextBlock
                                    Text="HISTORY"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#6C3CCB"/>

                            </Border>

                        </Grid>

                        <!-- Attendance Table -->
                        <DataGrid
                            x:Name="AttendanceDataGrid"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal"
                            HorizontalGridLinesBrush="#EEE8F5"
                            VerticalGridLinesBrush="#FFFFFF"
                            HeadersVisibility="Column"
                            RowHeight="48"
                            ColumnHeaderHeight="44"
                            BorderBrush="#E8E0F5"
                            BorderThickness="1"
                            Background="White"
                            Foreground="#3C334D"
                            AlternatingRowBackground="#FAF8FE"
                            RowBackground="White"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="#EFE7FB"/>
                                    <Setter Property="Foreground" Value="#57319B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Padding" Value="12,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Foreground" Value="#3C334D"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Date"
                                    Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}"
                                    Width="1.2*"
                                    MinWidth="115"/>

                                <DataGridTextColumn
                                    Header="Check In"
                                    Binding="{Binding CheckIn, StringFormat={}{0:hh:mm tt}}"
                                    Width="1*"
                                    MinWidth="100"/>

                                <DataGridTextColumn
                                    Header="Check Out"
                                    Binding="{Binding CheckOut, StringFormat={}{0:hh:mm tt}}"
                                    Width="1*"
                                    MinWidth="100"/>

                                <DataGridTextColumn
                                    Header="Working Hours"
                                    Binding="{Binding WorkingHours}"
                                    Width="1.2*"
                                    MinWidth="125"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- Footer Note -->
                        <TextBlock
                            Text="Your attendance records are displayed here based on the selected date range."
                            FontSize="12"
                            Foreground="#8B829B"
                            TextWrapping="Wrap"
                            Margin="0,16,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>

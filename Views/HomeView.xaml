<UserControl
    x:Class="OfficeAttendance.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

	<Grid Background="#F5F5F5">

		<ScrollViewer
            VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="35">

				<!-- Welcome -->
				<TextBlock
                    x:Name="WelcomeText"
                    Text="Welcome back!"
                    FontSize="30"
                    FontWeight="SemiBold"/>

				<TextBlock
                    Text="Here's your attendance overview for today."
                    FontSize="15"
                    Foreground="Gray"
                    Margin="0,5,0,30"/>


				<!-- Summary Cards -->
				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>


					<!-- Check In -->
					<Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,10,0">

						<StackPanel>

							<TextBlock
                                Text="CHECK IN"
                                FontSize="12"
                                Foreground="Gray"
                                FontWeight="SemiBold"/>

							<TextBlock
                                x:Name="CheckInTimeText"
                                Text="--:--"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"/>

							<TextBlock
                                Text="Today's check-in"
                                Foreground="Gray"
                                FontSize="12"/>

						</StackPanel>

					</Border>


					<!-- Check Out -->
					<Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        Margin="10,0">

						<StackPanel>

							<TextBlock
                                Text="CHECK OUT"
                                FontSize="12"
                                Foreground="Gray"
                                FontWeight="SemiBold"/>

							<TextBlock
                                x:Name="CheckOutTimeText"
                                Text="--:--"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"/>

							<TextBlock
                                Text="Today's check-out"
                                Foreground="Gray"
                                FontSize="12"/>

						</StackPanel>

					</Border>


					<!-- Working Hours -->
					<Border
                        Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        Margin="10,0,0,0">

						<StackPanel>

							<TextBlock
                                Text="WORKING HOURS"
                                FontSize="12"
                                Foreground="Gray"
                                FontWeight="SemiBold"/>

							<TextBlock
                                x:Name="WorkingHoursText"
                                Text="0h 0m"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"/>

							<TextBlock
                                Text="Today's total"
                                Foreground="Gray"
                                FontSize="12"/>

						</StackPanel>

					</Border>

				</Grid>


				<!-- Today's Attendance -->
				<Border
                    Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,25,0,0">

					<StackPanel>

						<TextBlock
                            Text="Today's Attendance"
                            FontSize="21"
                            FontWeight="SemiBold"/>

						<TextBlock
                            x:Name="StatusText"
                            Text="You have not checked in yet."
                            FontSize="14"
                            Foreground="Gray"
                            Margin="0,8,0,25"/>


						<!-- Buttons -->
						<StackPanel
                            Orientation="Horizontal">

							<ui:Button
                                x:Name="CheckInButton"
                                Content="Check In"
                                Click="CheckInButton_Click"
                                Width="140"
                                Margin="0,0,10,0"/>

							<ui:Button
                                x:Name="CheckOutButton"
                                Content="Check Out"
                                IsEnabled="False"
                                Click="CheckOutButton_Click"
                                Width="140"/>

						</StackPanel>

					</StackPanel>

				</Border>


				<!-- Information -->
				<Border
                    Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,20,0,0">

					<StackPanel>

						<TextBlock
                            Text="Attendance Information"
                            FontSize="18"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Text="Remember to check in when you start your workday and check out when you finish."
                            TextWrapping="Wrap"
                            Foreground="Gray"
                            Margin="0,8,0,0"/>

					</StackPanel>

				</Border>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</UserControl>


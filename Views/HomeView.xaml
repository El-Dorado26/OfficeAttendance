
<UserControl
    x:Class="OfficeAttendance.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="#F6F2FC">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28">

                <!-- Welcome Banner -->
                <Border
                    Background="#7045B5"
                    CornerRadius="22"
                    Padding="28"
                    Margin="0,0,0,28">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="EMPLOYEE DASHBOARD"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#E7DDF9"
                                Margin="0,0,0,10"/>

                            <TextBlock
                                x:Name="WelcomeText"
                                Text="Welcome back!"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="White"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Here's your attendance overview for today."
                                FontSize="14"
                                Foreground="#F0E9FC"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Width="60"
                            Height="60"
                            CornerRadius="30"
                            Background="#8B69C5"
                            VerticalAlignment="Center"
                            Margin="15,0,0,0">

                            <TextBlock
                                Text="&#x2713;"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Overview Heading -->
                <TextBlock
                    Text="Today's Overview"
                    FontSize="21"
                    FontWeight="Bold"
                    Foreground="#302044"
                    Margin="0,0,0,16"/>

                <!-- Summary Cards -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Check In -->
                    <Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,8,0"
                        BorderBrush="#EAE1F7"
                        BorderThickness="1">

                        <StackPanel>
                            <Border
                                Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#F0E8FF"
                                HorizontalAlignment="Left">

                                <TextBlock
                                    Text="&#x25B6;"
                                    FontSize="16"
                                    Foreground="#7045B5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="CHECK IN"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#877B96"
                                Margin="0,14,0,0"/>

                            <TextBlock
                                x:Name="CheckInTimeText"
                                Text="--:--"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#302044"
                                TextWrapping="Wrap"
                                Margin="0,5,0,4"/>

                            <TextBlock
                                Text="Today's check-in"
                                FontSize="12"
                                Foreground="#91879E"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Check Out -->
                    <Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="18"
                        Padding="18"
                        Margin="4,0"
                        BorderBrush="#EAE1F7"
                        BorderThickness="1">

                        <StackPanel>
                            <Border
                                Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#FCECF2"
                                HorizontalAlignment="Left">

                                <TextBlock
                                    Text="&#x25A0;"
                                    FontSize="16"
                                    Foreground="#C04B78"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="CHECK OUT"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#877B96"
                                Margin="0,14,0,0"/>

                            <TextBlock
                                x:Name="CheckOutTimeText"
                                Text="--:--"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#302044"
                                TextWrapping="Wrap"
                                Margin="0,5,0,4"/>

                            <TextBlock
                                Text="Today's check-out"
                                FontSize="12"
                                Foreground="#91879E"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Working Hours -->
                    <Border
                        Grid.Column="2"
                        Background="White"
                        CornerRadius="18"
                        Padding="18"
                        Margin="8,0,0,0"
                        BorderBrush="#EAE1F7"
                        BorderThickness="1">

                        <StackPanel>
                            <Border
                                Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#E7F7EE"
                                HorizontalAlignment="Left">

                                <TextBlock
                                    Text="&#x25F7;"
                                    FontSize="22"
                                    Foreground="#268653"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="WORKING HOURS"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#877B96"
                                TextWrapping="Wrap"
                                Margin="0,14,0,0"/>

                            <TextBlock
                                x:Name="WorkingHoursText"
                                Text="0h 0m"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#302044"
                                TextWrapping="Wrap"
                                Margin="0,5,0,4"/>

                            <TextBlock
                                Text="Today's total"
                                FontSize="12"
                                Foreground="#91879E"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Attendance Actions -->
                <Border
                    Background="White"
                    CornerRadius="20"
                    Padding="24"
                    BorderBrush="#EAE1F7"
                    BorderThickness="1"
                    Margin="0,0,0,22">

                    <StackPanel>
                        <TextBlock
                            Text="Manage Your Attendance"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#302044"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="Keep your attendance up to date throughout the day."
                            FontSize="13"
                            Foreground="#877B96"
                            TextWrapping="Wrap"
                            Margin="0,7,0,20"/>

                        <!-- Current Status -->
                        <Border
                            Background="#F7F3FD"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,22">

                            <StackPanel>
                                <TextBlock
                                    Text="CURRENT STATUS"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#877B96"
                                    Margin="0,0,0,7"/>

                                <TextBlock
                                    x:Name="StatusText"
                                    Text="You have not checked in yet."
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#59358F"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="BreakTimerText"
                                    Text=""
                                    FontSize="13"
                                    Foreground="#7045B5"
                                    TextWrapping="Wrap"
                                    Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Attendance Buttons -->
                        <WrapPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                            <ui:Button
                                x:Name="CheckInButton"
                                Content="Check In"
                                Click="CheckInButton_Click"
                                MinWidth="125"
                                Height="44"
                                Padding="16,8"
                                Background="#7045B5"
                                Foreground="White"
                                Margin="0,0,12,10"/>

                            <ui:Button
                                x:Name="BreakButton"
                                Content="Take Break"
                                Click="BreakButton_Click"
                                IsEnabled="False"
                                MinWidth="130"
                                Height="44"
                                Padding="16,8"
                                Margin="0,0,12,10"/>

                            <ui:Button
                                x:Name="CheckOutButton"
                                Content="Check Out"
                                Click="CheckOutButton_Click"
                                IsEnabled="False"
                                MinWidth="125"
                                Height="44"
                                Padding="16,8"
                                Margin="0,0,0,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Attendance Tips -->
                <Border
                    Background="#EEE6FA"
                    CornerRadius="18"
                    Padding="22"
                    Margin="0,0,0,10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="White"
                            VerticalAlignment="Top"
                            Margin="0,0,15,0">

                            <TextBlock
                                Text="&#x2139;"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="#7045B5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="Attendance Tips"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="#493064"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Remember to check in when you start your workday and check out when you finish. Use Take Break when you need a break, then resume when you're ready."
                                FontSize="13"
                                Foreground="#71627F"
                                TextWrapping="Wrap"
                                LineHeight="21"
                                Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

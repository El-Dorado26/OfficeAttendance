 <UserControl
    x:Class="OfficeAttendance.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid ClipToBounds="True">

        <!-- Soft lavender background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F0FF" Offset="0"/>
                <GradientStop Color="#E8DFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative background circles -->
        <Ellipse
            Width="300"
            Height="300"
            Fill="#D8C5FA"
            Opacity="0.35"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-100,-100,0,0"/>

        <Ellipse
            Width="260"
            Height="260"
            Fill="#C5AEF2"
            Opacity="0.30"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,-70,-90"/>

        <!-- Centered login card -->
        <Border
            Width="430"
            MaxWidth="430"
            Padding="36"
            CornerRadius="24"
            Background="#FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect
                    Color="#6741A5"
                    BlurRadius="30"
                    ShadowDepth="6"
                    Opacity="0.16"/>
            </Border.Effect>

            <StackPanel>

                <!-- Company logo -->
                <Border
                    Width="100"
                    Height="88"
                    CornerRadius="18"
                    Background="#F5F0FF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">

                    <Image
                        Source="/Images/MainLogo.png"
                        Width="78"
                        Height="72"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- Application title -->
                <TextBlock
                    Text="Office Attendance"
                    FontSize="27"
                    FontWeight="Bold"
                    Foreground="#302044"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

                <TextBlock
                    Text="EMPLOYEE PORTAL"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#7954B5"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,30"/>

                <!-- Welcome message -->
                <TextBlock
                    Text="Welcome back!"
                    FontSize="23"
                    FontWeight="SemiBold"
                    Foreground="#302044"
                    Margin="0,0,0,7"/>

                <TextBlock
                    Text="Sign in to access your attendance dashboard."
                    FontSize="13"
                    Foreground="#777080"
                    TextWrapping="Wrap"
                    Margin="0,0,0,26"/>

                <!-- Username -->
                <TextBlock
                    Text="Username"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#40344F"
                    Margin="0,0,0,8"/>

                <ui:TextBox
                    x:Name="UsernameTextBox"
                    TextChanged="UsernameTextBox_TextChanged"
                    PlaceholderText="Enter your username"
                    Height="46"
                    Padding="12,8"
                    Margin="0,0,0,19"/>

                <!-- Password -->
                <TextBlock
                    Text="Password"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#40344F"
                    Margin="0,0,0,8"/>

                <ui:PasswordBox
                    x:Name="PasswordBox"
                    PasswordChanged="PasswordBox_PasswordChanged"
                    PlaceholderText="Enter your password"
                    Height="46"
                    Padding="12,8"
                    Margin="0,0,0,12"/>

                <!-- Login error message -->
                <TextBlock
                    x:Name="ErrorMessage"
                    Text=""
                    Foreground="#C62828"
                    FontSize="12"
                    TextWrapping="Wrap"
                    MinHeight="8"
                    Margin="0,0,0,12"/>

                <!-- Sign in button -->
                <ui:Button
                    x:Name="LoginButton"
                    Content="Sign In"
                    Height="48"
                    HorizontalAlignment="Stretch"
                    Click="LoginButton_Click"
                    Background="#7045B5"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"/>

                <!-- Footer -->
                <TextBlock
                    Text="Secure Employee Access"
                    FontSize="11"
                    Foreground="#93889F"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>

<ui:FluentWindow
    x:Class="OfficeAttendance.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	Title="Office Attendance"
    Width="1200"
    Height="700"
    WindowStartupLocation="CenterScreen">

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition
                Width="220"/>

			<ColumnDefinition
                Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
		<Border
    x:Name="Sidebar"
    Grid.Column="0"
    Background="#202020"
    Visibility="Collapsed">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Application Header -->
        <StackPanel
            Margin="20,25,20,30">

            <TextBlock
                Text="OFFICE"
                Foreground="White"
                FontSize="13"
                FontWeight="SemiBold"
                Opacity="0.7"/>

            <TextBlock
                Text="ATTENDANCE"
                Foreground="White"
                FontSize="21"
                FontWeight="SemiBold"
                Margin="0,2,0,0"/>

        </StackPanel>


        <!-- Navigation -->
        <StackPanel
            Grid.Row="1"
            Margin="12,0">

            <TextBlock
                Text="MAIN"
                Foreground="White"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.5"
                Margin="10,0,0,8"/>

            <ui:Button
                x:Name="DashboardButton"
                Content="Dashboard"
                Click="DashboardButton_Click"
                Margin="0,3"/>

            <ui:Button
                x:Name="AttendanceButton"
                Content="Attendance"
                Click="AttendanceButton_Click"
                Margin="0,3"/>

            <ui:Button
                x:Name="UsersButton"
                Content="User Management"
                Click="UsersButton_Click"
                Margin="0,3"/>

        </StackPanel>


        <!-- User / Logout -->
        <StackPanel
            Grid.Row="2"
            Margin="12,15,12,20">

            <Border
                Background="#2B2B2B"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock
                        x:Name="SidebarUserName"
                        Text="User"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="SidebarUserRole"
                        Text="Employee"
                        Foreground="White"
                        FontSize="12"
                        Opacity="0.6"
                        Margin="0,3,0,0"/>

                </StackPanel>

            </Border>

            <ui:Button
                x:Name="LogoutButton"
                Content="Sign Out"
                Click="LogoutButton_Click"/>

        </StackPanel>

    </Grid>

</Border>


		<!-- Main Content -->
		<Grid
            x:Name="MainContent"
            Grid.Column="1">

		</Grid>

	</Grid>

</ui:FluentWindow>
